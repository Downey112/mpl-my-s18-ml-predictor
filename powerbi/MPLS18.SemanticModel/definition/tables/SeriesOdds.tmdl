		sourceColumn: Top Score

	partition SeriesOdds = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents(DataFolder & "\mpl_my_s18_series_odds.csv"),
				        [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"order", Int64.Type}, {"stage", type text}, {"team_a", type text}, {"team_b", type text}, {"best_of", Int64.Type}, {"rs_h2h_matches", type text}, {"rs_h2h_games", type text}, {"team_a_game_win_pct", type number}, {"team_a_series_win_pct", type number}, {"top_scoreline", type text}, {"top_scoreline_pct", type number}}, "en-US"),
				    AddMatchup = Table.AddColumn(Typed, "Matchup", each [team_a] & " vs " & [team_b], type text),
				    AddGame = Table.AddColumn(AddMatchup, "team_a_game_win", each [team_a_game_win_pct] / 100, type number),
				    AddSeries = Table.AddColumn(AddGame, "team_a_series_win", each [team_a_series_win_pct] / 100, type number),
				    AddTop = Table.AddColumn(AddSeries, "Top Score", each [top_scoreline] & " (" & Number.ToText([top_scoreline_pct], "0", "en-US") & "%)", type text),
				    Result = Table.SelectColumns(AddTop, {"order", "stage", "Matchup", "best_of", "rs_h2h_matches", "rs_h2h_games", "team_a_game_win", "team_a_series_win", "Top Score"})
				in
				    Result

	annotation PBI_ResultType = Table

