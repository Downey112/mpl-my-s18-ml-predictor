	partition Forecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents(DataFolder & "\mpl_my_s18_playoffs_forecast.csv"),
				        [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Team", type text}, {"Reach_UBSF_%", type number}, {"Reach_UBF_%", type number}, {"Reach_LBF_%", type number}, {"M8_Qual_GrandFinal_%", type number}, {"Champion_%", type number}, {"RunnerUp_2nd_%", type number}, {"3rd_Place_%", type number}, {"4th_Place_%", type number}, {"5th_6th_Place_%", type number}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"Reach_UBSF_%", "Reach UB Semifinal"}, {"Reach_UBF_%", "Reach UB Final"}, {"Reach_LBF_%", "Reach LB Final"}, {"M8_Qual_GrandFinal_%", "Grand Final"}, {"Champion_%", "Champion"}, {"RunnerUp_2nd_%", "Runner-up"}, {"3rd_Place_%", "Third"}, {"4th_Place_%", "Fourth"}, {"5th_6th_Place_%", "Fifth-Sixth"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

