table Forecast
	lineageTag: fb5fbb8b-78ba-5fd4-8290-16c85a5d270b

	measure 'Champion %' = DIVIDE ( SUM ( Forecast[Champion] ), 100 )
		formatString: 0.0%
		displayFolder: Base
		lineageTag: 0a28534e-9da4-5593-a1d2-fc9144f26c46

	measure 'Grand Final %' = DIVIDE ( SUM ( Forecast[Grand Final] ), 100 )
		formatString: 0.0%
		displayFolder: Base
		lineageTag: 0f0c96c7-ab26-5d52-a193-6deea8ddcbd1

	measure 'Card Favourite' =
			VAR _top =
			    CALCULATETABLE (
			        TOPN ( 1, ALL ( Forecast ), Forecast[Champion], DESC, Forecast[Team], ASC ),
			        REMOVEFILTERS ( Teams )
			    )
			VAR _team = MAXX ( _top, Forecast[Team] )
			VAR _p = MAXX ( _top, Forecast[Champion] ) / 100
			RETURN
			    _team & "  " & FORMAT ( _p, "0.0%" )
		displayFolder: Cards
		lineageTag: 7b7923eb-0f5f-5017-bfeb-411a07d6e570

	measure 'Card Second M8 Slot' =
			-- Teams ranked 2 and 3 by Grand Final odds; SRG is a near-lock for the first M8 slot
			VAR _top2 =
			    CALCULATETABLE (
			        TOPN ( 2, ALL ( Forecast ), Forecast[Grand Final], DESC, Forecast[Team], ASC ),
			        REMOVEFILTERS ( Teams )
			    )
			VAR _top3 =
			    CALCULATETABLE (
			        TOPN ( 3, ALL ( Forecast ), Forecast[Grand Final], DESC, Forecast[Team], ASC ),
			        REMOVEFILTERS ( Teams )
			    )
			VAR _row2 = TOPN ( 1, _top2, Forecast[Grand Final], ASC, Forecast[Team], DESC )
			VAR _row3 = TOPN ( 1, _top3, Forecast[Grand Final], ASC, Forecast[Team], DESC )
			VAR _second = MAXX ( _row2, Forecast[Team] )
			VAR _secondVal = MAXX ( _row2, Forecast[Grand Final] )
			VAR _third = MAXX ( _row3, Forecast[Team] )
			VAR _thirdVal = MAXX ( _row3, Forecast[Grand Final] )
			RETURN
			    _second & " " & FORMAT ( _secondVal / 100, "0%" ) & "  vs  " & _third & " " & FORMAT ( _thirdVal / 100, "0%" )
		displayFolder: Cards
		lineageTag: ee1bec6f-9621-5326-b80e-1b6732cb4658

	column Team
		dataType: string
		lineageTag: 5685b06e-7c85-509d-b600-83b59c24e0f7
		summarizeBy: none
		sourceColumn: Team

