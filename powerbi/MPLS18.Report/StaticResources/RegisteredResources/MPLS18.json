{
  "name": "MPLS18",
  "dataColors": [
    "#F2C14E",
    "#C0C7D4",
    "#C27C48",
    "#6B9BE8",
    "#7A8AA6",
    "#3BC9F5"
  ],
  "background": "#111D35",
  "foreground": "#F1F5F9",
  "backgroundLight": "#0E1830",
  "foregroundNeutralSecondary": "#8DA2C0",
  "tableAccent": "#F2C14E",
  "good": "#34D399",
  "neutral": "#8DA2C0",
  "bad": "#F87171",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
      "color": "#F1F5F9"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
      "color": "#F2C14E"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#F2C14E"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#8DA2C0"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0A1222"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0A1222"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#111D35"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#C9A04A"
              }
            },
            "radius": 8,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 16,
            "right": 16
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F2C14E"
              }
            },
            "fontSize": 11,
            "fontFamily": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
            "alignment": "left"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "fontSize": 22,
            "fontFamily": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif"
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "fontSize": 9,
            "labelPosition": "OutsideEnd"
          }
        ],
        "legend": [
          {
            "show": false,
            "labelColor": {
              "solid": {
                "color": "#8DA2C0"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "hundredPercentStackedBarChart": {
      "*": {
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 8,
            "color": {
              "solid": {
                "color": "#0A1222"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#8DA2C0"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#22324F"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#22324F"
              }
            },
            "textSize": 9
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#F2C14E"
              }
            },
            "backColor": {
              "solid": {
                "color": "#111D35"
              }
            },
            "fontFamily": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "backColor": {
              "solid": {
                "color": "#111D35"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#0E1830"
              }
            },
            "fontSize": 9
          }
        ]
      }
    }
  }
}
