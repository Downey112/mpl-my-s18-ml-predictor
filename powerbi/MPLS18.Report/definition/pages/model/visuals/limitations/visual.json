          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Limitations",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Elo gets a negative weight (−1.06) because season averages already encode team strength; a bigger Elo lead slightly lowers the ML probability.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#64748B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  The final game probability blends ML 45%, Bradley-Terry 30%, Elo 15% and head-to-head 10%. These weights and the 0.68 match-to-game factor are judgement calls, not fitted.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#64748B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  56 matches is a small sample. Treat the forecast as an informed opinion, not a precise estimate.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#64748B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Data: 56 regular-season results (checked against Liquipedia) and team season totals from my.mpl.mobilelegends.com.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#64748B"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
